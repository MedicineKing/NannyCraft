<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\NannyCraft.ico</ApplicationIcon>
    <!-- 显示名:NannyCraft(内部命名空间保持 McLauncher,避免大改) -->
    <AssemblyName>NannyCraft</AssemblyName>
    <AssemblyTitle>NannyCraft</AssemblyTitle>
    <Product>NannyCraft</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 构建日期写进程序集元数据,设置页/关于页直接读取 -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

</Project>
