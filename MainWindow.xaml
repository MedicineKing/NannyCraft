<ui:FluentWindow x:Class="McLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NannyCraft" Height="680" Width="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13.5">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fluent 标题栏:仅最小化/关闭,无最大化(ResizeMode=CanMinimize 同时禁掉双击放大) -->
        <ui:TitleBar Grid.Row="0" Title="NannyCraft" ShowMaximize="False"/>

        <!-- ═══ 主体:左侧导航 + 内容区 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0">
                <Grid Margin="14,6,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE80F;"
                                     Content="{DynamicResource S_NavHome}" IsChecked="True" Checked="OnNavChecked"/>
                        <RadioButton x:Name="NavDownload" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE896;"
                                     Content="{DynamicResource S_NavDownload}" Margin="0,4,0,0" Checked="OnNavChecked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE713;"
                                     Content="{DynamicResource S_NavSettings}" Margin="0,4,0,0" Checked="OnNavChecked"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE946;"
                                     Content="{DynamicResource S_NavAbout}" Margin="0,4,0,0" Checked="OnNavChecked"/>
                    </StackPanel>

                    <!-- 版本行:版本号保持绑定,「本地优先」拆成独立 Run 以支持运行时切语言 -->
                    <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Margin="8,0,0,0"><Run Text="{Binding VersionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{DynamicResource S_LocalFirst}"/></TextBlock>
                </Grid>
            </Border>

            <!-- ═══ 右侧内容区 ═══ -->
            <Grid Grid.Column="1" Margin="22,14,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

                <Grid Grid.Row="1" x:Name="PageHost">

                    <!-- ── 主页 ── -->
                    <Grid x:Name="PageHome">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Hero:背景图/渐变 + 选中版本 + 大启动键(SJMCL 式) -->
                        <Border Grid.Row="0" CornerRadius="8" Margin="0,0,0,14" ClipToBounds="True">
                            <Grid Height="186">
                                <Rectangle Fill="{Binding HeroGradient}"/>
                                <Rectangle Fill="{Binding HeroBrush}"/>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#E0141517" Offset="0"/>
                                            <GradientStop Color="#66141517" Offset="0.72"/>
                                            <GradientStop Color="#99141517" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Grid Margin="26,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="480">
                                        <TextBlock Text="Minecraft" FontSize="13" Foreground="#9FB2D0"/>
                                        <TextBlock Text="{Binding HeroTitle}"
                                                   FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CheckText, TargetNullValue=从下面列表里选一个已安装的版本}"
                                                   Foreground="#C9D2E0" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="38"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Width="230">
                                        <ui:Button Appearance="Primary" Content="{Binding LaunchButtonText}"
                                                   Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}"
                                                   Height="52" FontSize="15.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="340"/>
                            </Grid.ColumnDefinitions>

                            <ui:Card Grid.Column="0" Padding="18" Margin="0,0,14,0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource S_InstalledVersions}" Style="{StaticResource SectionTitle}"/>
                                    <ListView Grid.Row="1"
                                              ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedVersion}"
                                              Background="Transparent" BorderThickness="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" FontSize="16"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            <Border Style="{StaticResource TypeChip}">
                                                                <TextBlock Style="{StaticResource TypeChipText}" Text="{Binding DisplayType}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding ReleaseTime, StringFormat=yyyy-MM-dd}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                                        <!-- 空状态拆三个 Run:前缀 + 链接(Hyperlink 无 Text 属性,文字放内层 Run)+ 后缀 -->
                                        <TextBlock FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"><Run Text="{DynamicResource S_EmptyPrefix}"/><Hyperlink Click="OnInstallLinkClick" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"><Run Text="{DynamicResource S_EmptyLink}"/></Hyperlink><Run Text="{DynamicResource S_EmptySuffix}"/></TextBlock>
                                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                                   Text="{DynamicResource S_EmptyHint}"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <ui:Card x:Name="DetailCard" Grid.Column="1" Padding="18" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <Grid>
                                    <!-- 已选中版本:详情 + 补全 -->
                                    <StackPanel Visibility="{Binding HasSelectedVersion, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource S_GameDetails}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding SelectedVersion.Id}" FontSize="19" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding JavaHint}" Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding CheckText}"
                                                   TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="36"/>
                                        <ui:Button Appearance="Primary" Content="{Binding JavaDownloadText}" Height="34"
                                                   HorizontalAlignment="Left" MinWidth="132"
                                                   Command="{Binding DownloadJavaCommand}" Margin="0,12,0,0"
                                                   Visibility="{Binding NeedsJavaDownload, Converter={StaticResource BoolToVis}}"/>
                                        <ui:Button Appearance="Secondary" Content="{DynamicResource S_OneClickComplete}" Height="36"
                                                   Command="{Binding InstallCommand}" Margin="0,16,0,0"/>
                                        <ui:Button Appearance="Secondary" Content="{DynamicResource S_GameSettingsBtn}" Height="36"
                                                   Command="{Binding OpenGameSettingsCommand}" Margin="0,10,0,0"/>
                                        <ui:Button Appearance="Secondary" Content="{DynamicResource S_OpenGameFolder}" Height="36"
                                                   Command="{Binding OpenGameFolderCommand}" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <!-- 未选版本:今日 MC 快讯 -->
                                    <Grid Visibility="{Binding ShowNewsPanel, Converter={StaticResource BoolToVis}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource S_TodayNews}" Style="{StaticResource SectionTitle}"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding News}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,14">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Date}" Margin="0,2,0,0"/>
                                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}"
                                                                       TextWrapping="Wrap" MaxHeight="44" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- 未选版本且关闭快讯 -->
                                    <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource S_PickVersionHint}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ShowIdleHint, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </ui:Card>
                        </Grid>
                    </Grid>

                    <!-- ── 下载 ── -->
                    <Grid x:Name="PageDownload" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Padding="18" Margin="0,0,14,0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource S_ChooseVersion}" Style="{StaticResource SectionTitle}"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- PCL2 式分类列:图标 + 文字,整行选中(复用导航项样式;枚举放 Uid,Tag 让给图标码点) -->
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <RadioButton Style="{StaticResource NavItem}" GroupName="vkind" Height="36" Uid="Release"
                                                     Tag="&#xE735;" Content="{DynamicResource S_FilterRelease}" IsChecked="True"
                                                     Checked="OnVersionKindChecked"/>
                                        <RadioButton Style="{StaticResource NavItem}" GroupName="vkind" Height="36" Uid="Snapshot"
                                                     Tag="&#xE823;" Content="{DynamicResource S_FilterSnapshot}" Margin="0,4,0,0"
                                                     Checked="OnVersionKindChecked"/>
                                        <RadioButton Style="{StaticResource NavItem}" GroupName="vkind" Height="36" Uid="AprilFools"
                                                     Tag="&#xE76E;" Content="{DynamicResource S_FilterAprilFools}" Margin="0,4,0,0"
                                                     Checked="OnVersionKindChecked"/>
                                        <RadioButton Style="{StaticResource NavItem}" GroupName="vkind" Height="36" Uid="Ancient"
                                                     Tag="&#xE81C;" Content="{DynamicResource S_FilterAncient}" Margin="0,4,0,0"
                                                     Checked="OnVersionKindChecked"/>
                                    </StackPanel>
                                    <ListView Grid.Column="1"
                                              ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                                              Background="Transparent" BorderThickness="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </ui:Card>

                        <ui:Card Grid.Column="1" Padding="18" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Grid>
                                <!-- 已选中版本:安装面板 -->
                                <StackPanel Visibility="{Binding HasSelectedVersion, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource S_Install}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding SelectedVersion.Id}" FontSize="19" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding JavaHint}" Margin="0,8,0,0"/>
                                    <ProgressBar Height="6" Margin="0,16,0,0" Value="{Binding Progress}" Maximum="100"
                                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                                    <ui:Button Appearance="Primary" Content="{DynamicResource S_Install}" Height="34" FontSize="13.5"
                                               HorizontalAlignment="Left" MinWidth="132"
                                               Command="{Binding InstallCommand}" Margin="0,14,0,0"/>
                                </StackPanel>

                                <!-- 未选版本:提示 -->
                                <StackPanel Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                                               MaxWidth="230" LineHeight="20"
                                               Text="{DynamicResource S_NoSelectionInstallHint}"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </Grid>

                    <!-- ── 设置(PCL 式左列分类 + 右侧内容) ── -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 左列分类(复用导航项样式;Uid=分类,Tag=图标码点) -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Width="158" Margin="0,0,14,0">
                            <RadioButton Style="{StaticResource NavItem}" GroupName="setcat" Height="36" Uid="Game"
                                         Tag="&#xE7FC;" Content="{DynamicResource S_SetCat_Game}" IsChecked="True"
                                         Checked="OnSettingsCategoryChecked"/>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="setcat" Height="36" Uid="Look"
                                         Tag="&#xE790;" Content="{DynamicResource S_SetCat_Look}" Margin="0,4,0,0"
                                         Checked="OnSettingsCategoryChecked"/>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="setcat" Height="36" Uid="Isolate"
                                         Tag="&#xE8AB;" Content="{DynamicResource S_SetCat_Isolate}" Margin="0,4,0,0"
                                         Checked="OnSettingsCategoryChecked"/>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="setcat" Height="36" Uid="News"
                                         Tag="&#xE716;" Content="{DynamicResource S_SetCat_News}" Margin="0,4,0,0"
                                         Checked="OnSettingsCategoryChecked"/>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="setcat" Height="36" Uid="Update"
                                         Tag="&#xE895;" Content="{DynamicResource S_SetCat_Update}" Margin="0,4,0,0"
                                         Checked="OnSettingsCategoryChecked"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,14,0">
                            <StackPanel x:Name="SetCatGame">
                            <ui:Card Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_Game}" Style="{StaticResource SectionTitle}"/>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_MaxMemory}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True"
                                                Value="{Binding MaxMemoryMb}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="72"
                                                   TextAlignment="Right"
                                                   Text="{Binding MaxMemoryMb, StringFormat='{}{0} MB'}"/>
                                    </Grid>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_GameDir}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding GameRoot}" IsReadOnly="True"/>
                                        <ui:Button Grid.Column="1" Appearance="Secondary" Content="{DynamicResource S_Choose}" MinWidth="72"
                                                   Margin="10,0,0,0" Command="{Binding ChooseGameFolderCommand}"/>
                                        <ui:Button Grid.Column="2" Appearance="Secondary" Content="{DynamicResource S_Open}" MinWidth="72"
                                                   Margin="10,0,0,0" Command="{Binding OpenGameFolderCommand}"/>
                                    </Grid>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_Username}"/>
                                    <TextBox Text="{Binding Username}"/>

                                    <CheckBox Content="{DynamicResource S_RememberLast}" IsChecked="{Binding RememberLastVersion}"
                                              Margin="0,14,0,0"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="{DynamicResource S_RememberLastHint}"/>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_DownloadConcurrency}"/>
                                    <Slider Minimum="16" Maximum="1024" TickFrequency="16" IsSnapToTickEnabled="True"
                                            Value="{Binding DownloadConcurrency}"
                                            IsEnabled="{Binding ManualConcurrencyEnabled}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox Content="{DynamicResource S_Auto}" IsChecked="{Binding AutoConcurrency}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding EffectiveConcurrencyText}"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Java"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Javas}" SelectedItem="{Binding SelectedJava}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Version, StringFormat='Java {0}'}" FontWeight="SemiBold"/>
                                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding SourceText}" Margin="8,0,0,0"/>
                                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Home}" Margin="8,0,0,0"
                                                                   MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ui:Button Grid.Column="1" Appearance="Secondary" Content="{DynamicResource S_ManualAddJava}" MinWidth="96"
                                                   Margin="10,0,0,0" Command="{Binding AddJavaCommand}"/>
                                    </Grid>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_JvmArgsLabel}"/>
                                    <TextBox Text="{Binding JvmArgs}" ToolTip="例如 -XX:+UseG1GC"/>

                                </StackPanel>
                            </ui:Card>
                            </StackPanel><!-- /SetCatGame -->

                            <StackPanel x:Name="SetCatLook" Visibility="Collapsed">
                            <ui:Card Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_Appearance}" Style="{StaticResource SectionTitle}"/>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_LauncherLang}"/>
                                    <ComboBox ItemsSource="{Binding LauncherLanguages}" SelectedItem="{Binding SelectedLanguage}"
                                              MaxWidth="220" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_ThemeColor}"/>
                                    <ItemsControl ItemsSource="{Binding AccentOptions}" HorizontalAlignment="Left">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="accent" Margin="0,0,12,0" Cursor="Hand" MinWidth="0" Padding="0"
                                                             ToolTip="{Binding Name}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Checked="OnAccentChecked">
                                                    <RadioButton.Template>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Grid Width="30" Height="30" Background="Transparent">
                                                                <Ellipse x:Name="ring" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                                                         StrokeThickness="2" Opacity="0" Margin="-4"/>
                                                                <Ellipse Fill="{Binding Brush}"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="ring" Property="Opacity" Value="1"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ring" Property="Opacity" Value="0.45"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </RadioButton.Template>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                               Text="{DynamicResource S_ThemeColorHint}"/>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_Background}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding BackgroundImage, Mode=OneWay}" IsReadOnly="True"/>
                                        <ui:Button Grid.Column="1" Appearance="Secondary" Content="{DynamicResource S_Choose}" MinWidth="72"
                                                   Margin="10,0,0,0" Command="{Binding ChooseBackgroundCommand}"/>
                                        <ui:Button Grid.Column="2" Appearance="Secondary" Content="{DynamicResource S_Clear}" MinWidth="72"
                                                   Margin="10,0,0,0" Command="{Binding ClearBackgroundCommand}"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                               Text="{DynamicResource S_BackgroundHint}"/>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_AnimSpeed}"/>
                                    <ComboBox ItemsSource="{Binding AnimationSpeeds}" SelectedItem="{Binding SelectedAnimationSpeed}"
                                              MaxWidth="220" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                               Text="{DynamicResource S_AnimSpeedHint}"/>

                                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                               Text="{DynamicResource S_NewsCardHint}"/>
                                </StackPanel>
                            </ui:Card>
                            </StackPanel><!-- /SetCatLook -->

                            <StackPanel x:Name="SetCatIsolate" Visibility="Collapsed">
                            <!-- ── 版本同步:两栏之间用按钮移动(不用 RelativeSource 命令绑定,走 Click 事件) ── -->
                            <ui:Card Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_SyncTitle}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" Text="{DynamicResource S_SyncHint}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,6" Text="{DynamicResource S_SyncGroup}"/>
                                            <ItemsControl ItemsSource="{Binding SyncedVersions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Id}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <ui:Button Grid.Column="1" Appearance="Secondary" Height="32" MinWidth="86"
                                                                       Content="{DynamicResource S_ToIsolate}" Click="OnIsolateClick"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,6" Text="{DynamicResource S_IsolationGroup}"/>
                                            <ItemsControl ItemsSource="{Binding IsolatedVersionEntries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Id}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <ui:Button Grid.Column="1" Appearance="Secondary" Height="32" MinWidth="86"
                                                                       Content="{DynamicResource S_ToRestore}" Click="OnRestoreClick"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            </StackPanel><!-- /SetCatIsolate -->

                            <StackPanel x:Name="SetCatNews" Visibility="Collapsed">
                            <ui:Card Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_News}" Style="{StaticResource SectionTitle}"/>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_NewsSource}"/>
                                    <TextBox Text="{Binding NewsSourceUrl}"
                                             ToolTip="默认 https://launchercontent.mojang.com/v2/javaPatchNotes.json"/>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_NewsProxy}"/>
                                    <TextBox Text="{Binding NewsProxy}"/>

                                    <CheckBox Content="{DynamicResource S_NewsShowToggle}" IsChecked="{Binding ShowNewsOnIdle}"
                                              Margin="0,14,0,0"/>

                                    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                                               Text="{DynamicResource S_NewsHint}"/>
                                </StackPanel>
                            </ui:Card>
                            </StackPanel><!-- /SetCatNews -->

                            <StackPanel x:Name="SetCatUpdate" Visibility="Collapsed">
                            <ui:Card Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_VersionUpdate}" Style="{StaticResource SectionTitle}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource S_Version}" Margin="0,4"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontWeight="SemiBold" Margin="0,4"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="{DynamicResource S_BuildDate}" Margin="0,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuildDateText}" Margin="0,4"/>
                                        <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Text="{DynamicResource S_InstallDate}" Margin="0,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstallDate}" Margin="0,4"/>
                                    </Grid>

                                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource S_Channel}"/>
                                    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
                                              MaxWidth="220" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <ui:Button Appearance="Secondary" Content="{DynamicResource S_CheckUpdate}" Height="38" MinWidth="96"
                                                   Command="{Binding CheckUpdateCommand}"/>
                                        <ui:Button Appearance="Primary" Content="{DynamicResource S_ApplyUpdate}" Height="38" MinWidth="96"
                                                   Margin="10,0,0,0" Command="{Binding ApplyUpdateCommand}"
                                                   Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding UpdateStatus}"
                                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:Card>
                            </StackPanel><!-- /SetCatUpdate -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 全局「保存设置」栏:所有分类常驻可见;没有改动时置灰 -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button Appearance="Primary" Content="{DynamicResource S_Save}" Height="38"
                                       IsEnabled="{Binding SettingsDirty}"
                                       Command="{Binding SaveSettingsCommand}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SettingsSavedHint}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>

                    <!-- ── 关于 ── -->
                    <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,14,0">
                            <ui:Card Padding="18">
                                <StackPanel>
                                    <TextBlock Text="NannyCraft" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"><Run Text="{Binding VersionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{DynamicResource S_Slogan}"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="21"
                                               Text="{DynamicResource S_AboutDesc}"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21"
                                               Text="{DynamicResource S_AboutLegal}"/>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"
                                               Text="{DynamicResource S_AboutTech}"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding RenderInfo}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_HelpFeedback}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                               Text="{DynamicResource S_HelpDesc}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Appearance="Primary" Content="{DynamicResource S_ReportBug}" Height="38"
                                                   Command="{Binding ReportBugCommand}"/>
                                        <ui:Button Appearance="Secondary" Content="{DynamicResource S_SuggestIdea}" Height="38"
                                                   Command="{Binding SuggestIdeaCommand}" Margin="10,0,0,0"/>
                                        <ui:Button Appearance="Secondary" Content="{DynamicResource S_QQFeedback}" Height="38"
                                                   Command="{Binding OpenQQGroupCommand}" Margin="10,0,0,0"/>
                                        <ui:Button Appearance="Secondary" Content="{DynamicResource S_OpenLogFolder}" Height="38"
                                                   Command="{Binding OpenLogFolderCommand}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding LauncherIdText}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 底栏:状态 + 进度 -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <ProgressBar Grid.Column="1" Width="220" Height="6" VerticalAlignment="Center"
                                 Value="{Binding Progress}" Maximum="100"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
