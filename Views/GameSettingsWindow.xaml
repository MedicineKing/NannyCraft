<ui:FluentWindow x:Class="McLauncher.Views.GameSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource S_GS_Title}" Height="680" Width="880"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize" WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13.5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource S_GS_Title}" ShowMaximize="False"/>

        <Grid Grid.Row="1" Margin="20,8,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 搜索:多词空格分词 + Edge/QQ 式下拉候选 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource S_GS_SearchTip}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="12,0,0,0" Text="{DynamicResource S_GS_SearchHint}"/>

                <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=SearchBox}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="{Binding ShowSuggestions, Mode=TwoWay}">
                    <!-- 注意:必须用"实色"画刷——Card* 是半透明层色,会让底层列表透上来 -->
                    <Border CornerRadius="8" BorderThickness="1" Padding="4" Margin="0,4,0,0"
                            MinWidth="{Binding ActualWidth, ElementName=SearchBox}"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnSuggestionClick" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" CornerRadius="6" Background="Transparent" Padding="8,6">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background"
                                                                Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Key}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,8,0,4">
                <TextBlock Style="{StaticResource Muted}" Text="{Binding FormatHint}"/>
                <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource S_GS_FollowHint}"/>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding FilePath}" FontSize="10.5"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7" Visibility="{Binding Visible, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}"/>
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Key}" FontSize="10.5"/>
                                    </StackPanel>

                                    <Grid Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                        <!-- 数值 -->
                                        <Grid Visibility="{Binding IsNumberEditor, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                    TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                                                    Value="{Binding NumberValue}"/>
                                            <TextBlock Grid.Column="1" MinWidth="52" TextAlignment="Right"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Text="{Binding DisplayValue}"/>
                                        </Grid>
                                        <!-- 开关 -->
                                        <CheckBox Content="{DynamicResource S_GS_On}" IsChecked="{Binding BoolValue}"
                                                  HorizontalAlignment="Left"
                                                  Visibility="{Binding IsToggleEditor, Converter={StaticResource BoolToVis}}"/>
                                        <!-- 选择 -->
                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding TextValue}"
                                                  MaxWidth="260" HorizontalAlignment="Left"
                                                  Visibility="{Binding IsChoiceEditor, Converter={StaticResource BoolToVis}}"/>
                                        <!-- 键位 -->
                                        <ui:Button Content="{Binding KeyDisplay}" MinWidth="120"
                                                   HorizontalAlignment="Left" Click="OnKeybindClick"
                                                   Visibility="{Binding IsKeybindEditor, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                               Text="{Binding MissingText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 未生成 options.txt 时的提示 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding FileMissing, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap"
                               Text="{DynamicResource S_GS_NoOptions}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="20,12,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button Appearance="Primary" Content="{DynamicResource S_GS_Save}" Height="34" MinWidth="104"
                       Click="OnSaveClick"/>
            <ui:Button Grid.Column="1" Appearance="Secondary" Content="{DynamicResource S_GS_Reload}" Height="34" MinWidth="104"
                       Margin="10,0,0,0" Click="OnReloadClick"/>
            <TextBlock Grid.Column="2" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Margin="14,0,0,0" Text="{Binding StatusText}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
